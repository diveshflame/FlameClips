# GEMINI_API_KEY: Required for Gemini AI transcription and clip moment analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: Public base URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Security secrets for session signing and signed media URLs (auto-generated in dev if omitted)
SESSION_SECRET=""
SIGNED_URL_SECRET=""

# Storage & database paths
STORAGE_DIR="./storage"
DATABASE_PATH="./storage/clipforge.db"

# Upload & quota limits
MAX_UPLOAD_MB="500"
MAX_USER_STORAGE_MB="2048"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_ANALYSIS_MODEL="gemini-4-hydrogen"
